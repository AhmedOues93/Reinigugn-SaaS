# SauberWerk — application configuration.
#
# Copy to .env.local for development. Staging and production set the same names
# in their hosting platform's environment settings. Never commit a filled-in
# copy: .env.local is git-ignored, and every value below is per-environment.
#
# See docs/deployment.md for the full staging procedure.

# ---------------------------------------------------------------------------
# Which deployment this is: local | staging | production
#
# Anything else (including unset) is treated as `local`, so a missing value can
# only ever make an environment safer, never more permissive. Staging uses this
# to keep outbound e-mail away from real recipients — see the mail block below.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# Supabase.
#
# Local: take both values from `npx supabase status`.
# Staging/production: Supabase dashboard → Project Settings → API.
#
# The publishable (anon) key is the only Supabase credential the application
# uses for anything a user does. Every access decision is made by row-level
# security in the database.
#
# There is exactly one exception, and it is optional: the Resend delivery
# webhook needs to write without a user session, so it uses a service-role key
# (see the delivery-events block below). Nothing else may. A service-role key
# bypasses RLS entirely, and anything reachable from a `NEXT_PUBLIC_` name is
# compiled into the browser bundle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# ---------------------------------------------------------------------------
# The application's own public origin.
#
# Used for links that arrive by e-mail (invitations, password resets) and so
# cannot be relative. It must match the dev server's actual port and, in
# Supabase Auth → URL Configuration, the Site URL plus one redirect entry:
#
#   <this value>/auth/callback
#
# Required outside local development: the app refuses to start rather than send
# people a link pointing at their own machine.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Outbound e-mail (invoices, payment reminders, invitations).
#
# One provider is chosen by configuration, not by environment:
#   RESEND_API_KEY set  → Resend over HTTPS  (staging and production)
#   otherwise SMTP_HOST → any SMTP server    (Mailpit locally, or a relay)
#   neither             → sending is off; every attempt records
#                         "not configured" and nothing is ever reported as sent
#
# Resend is the staging default because it needs only an outbound HTTPS
# request, which every serverless host allows, where SMTP ports are often
# blocked. It also returns a message id per send and honours an idempotency
# key, so a retried request cannot deliver twice.
#
# Local: `npx supabase start` runs Mailpit, which accepts every address and
# keeps everything on your machine. Expose its SMTP port in
# supabase/config.toml ([inbucket] smtp_port), restart Supabase, then read the
# mail at http://127.0.0.1:54324.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
MAIL_FROM="Ihre Firma <rechnung@example.de>"
# Where replies go, if not the From address.
# MAIL_REPLY_TO=buero@example.de

# --- SMTP, for local development or a self-hosted relay --------------------
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Staging safety -------------------------------------------------------
#
# Staging data looks like real data: a customer row carries a real mailbox. To
# stop a test invoice reaching an actual customer, outbound mail from a
# `staging` environment goes only to addresses named here.
#
# MAIL_ALLOWED_RECIPIENTS: comma-separated. A full address (`qa@firma.de`) or a
#   whole domain (`@firma.de`). These are delivered normally.
# MAIL_CATCH_ALL: everything else is redirected here instead, with the intended
#   recipient shown in the subject and the first line of the message.
#
# With neither set, staging refuses to send and says so. That is intentional: a
# staging environment that silently mails customers is the worse failure.
# Both are ignored when NEXT_PUBLIC_APP_ENV=production.
# ---------------------------------------------------------------------------
# MAIL_ALLOWED_RECIPIENTS=@ihre-firma.de
# MAIL_CATCH_ALL=staging-postfach@ihre-firma.de

# --- Delivery events (optional) -------------------------------------------
#
# Resend can report delivered/bounced/complained to a webhook at
# /api/webhooks/resend. Both values are needed, or the endpoint reports that it
# is not configured rather than accepting unverified writes.
#
# SUPABASE_SERVICE_ROLE_KEY is the ONLY privileged credential in this system.
# It is used by that one route handler and nothing else. Never give it a
# NEXT_PUBLIC_ name: anything so named is compiled into the browser bundle.
# Leave both unset and everything except delivery events works normally.
# ---------------------------------------------------------------------------
# RESEND_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Tests.
#
# The Supabase integration tests and the Playwright end-to-end suite both skip
# themselves unless these are present, so `pnpm test` stays green on a machine
# with no backend. Point them at a disposable staging project — never at
# production, and never at a project holding real customer data: the suites
# sign in as these users and write rows.
# ---------------------------------------------------------------------------
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=

# End-to-end. E2E_BASE_URL points Playwright at an already-running app; leave it
# unset and Playwright builds and serves the app itself on port 3100.
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_OWNER_EMAIL=
# E2E_OWNER_PASSWORD=
# E2E_EMPLOYEE_EMAIL=
# E2E_EMPLOYEE_PASSWORD=
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
#
# The authenticated suite writes rows and refuses to run against a target that
# looks like production or that reports data-app-env="production".
