NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key
# Must match `next dev`'s actual port and supabase/config.toml's [auth] site_url /
# additional_redirect_urls, or email confirmation and password-reset links break.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Outbound e-mail for invoices and payment reminders (any SMTP provider).
# Leave unset to disable sending: the app then records "not configured" and never
# claims a delivery. Locally, Mailpit can receive mail once its SMTP port is
# exposed (see supabase/config.toml [inbucket] smtp_port) and Supabase restarted.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM="Ihre Firma <rechnung@example.de>"
